{
  "compilerOptions": 
  {
    "checkJs": true,
    "allowJs": true,
    "module": "ES2020",
    "target": "ES2020",
    "declaration": true,
    "emitDeclarationOnly": false,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "moduleDetection": "force",
    "allowSyntheticDefaultImports":true,
    "skipLibCheck": false,
    "rootDirs": ["./app/model/"],
    "outDir": "_types/",
    "declarationDir": "_types/"
  },
  "files": [
    "./threeTree.config.js"
  ],
  "include": [
    "app/**/*.ts",
  ],
  "exclude": [
    "_types/threeTree.config.d.ts",
    "node_modules/",
    "app/**/*.js",
  ]
}

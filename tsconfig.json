{
  "compilerOptions": 
  {
    "allowJs": true,
    "module": "ES2015",
    "target": "ES2015",
    "declaration": true,
    "emitDeclarationOnly": false,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "moduleDetection": "force",
    "allowSyntheticDefaultImports":true,
    "skipLibCheck": false,
    "declarationMap": true,
    "rootDirs": ["./app","./threeTree.config.js"],
    "outDir": "@types/",
    "declarationDir":"@types/",
  },

  "include": [
    "app/**/*.ts",
    "@types/**/*.d.ts",
    "./threeTree.config.js"
  ],
  "exclude": [
    "@types/declartion",
    "node_modules/",
    "app/**/*.js",
  ]
}
